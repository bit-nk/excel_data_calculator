# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finops_chargeback
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/finops_chargeback

# App — REQUIRED: generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=false
ALLOWED_ORIGINS=https://your-production-domain.com

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_CUR_S3_BUCKET=
AWS_CUR_S3_PREFIX=

# MongoDB Atlas
MONGODB_ATLAS_PUBLIC_KEY=
MONGODB_ATLAS_PRIVATE_KEY=
MONGODB_ATLAS_ORG_ID=

# Datadog
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com

# Confluent
CONFLUENT_API_KEY=
CONFLUENT_API_SECRET=

# SingleStore
SINGLESTORE_API_KEY=

# Harness
HARNESS_API_TOKEN=
HARNESS_ACCOUNT_ID=

# Management Fee
MANAGEMENT_FEE_RATE=0.20
